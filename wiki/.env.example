# 飞书同步脚本环境变量示例（复制为 .env 填写，.env 已被 gitignore 忽略）
# 用法：cd wiki && cp .env.example .env && pnpm sync:feishu

# 飞书自建应用凭据（必填，应用需开通云文档相关权限）：
#  - docx: docx:document:readonly（或 docx:document 读写）
#  - drive: drive:drive:readonly（读取文件夹列表，可选）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 内容源（二选一，逗号分隔多个文档 token）：
# 1) 直接指定 docx 文档 token 列表
FEISHU_DOC_TOKENS=docx_token_1,docx_token_2
# 2) 多维表格（可选）：bitable 应用 token + 数据表 id
# FEISHU_BITABLE_APP_TOKEN=basxxxxxxxx
# FEISHU_BITABLE_TABLE_ID=tblxxxxxxxx

# 输出目录（默认 wiki/docs/feishu）
# FEISHU_OUTPUT_DIR=docs/feishu

# 只打印不写文件（默认 0；设 1 进入 dry-run）
# FEISHU_DRY_RUN=0
