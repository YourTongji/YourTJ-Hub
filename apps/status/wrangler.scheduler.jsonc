{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourtj-status-scheduler-preview",
  "account_id": "fc5e2d06f36d7408ebb70d3c501de6d8",
  "main": "worker/scheduler.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
