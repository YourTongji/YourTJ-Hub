# Local collector example; never use VITE_* for secrets. Production secrets belong to GitHub status-collector.
STATUS_ENABLED=false
UMAMI_URL=
UMAMI_SHARE_ID=
# Optional server-only Umami account with read access to this website's Breakdown report.
# Never prefix these secrets with VITE_. Basic traffic statistics do not require them.
UMAMI_USERNAME=
UMAMI_PASSWORD=
KOMARI_URL=
KOMARI_NODE_ID=
UPTIME_URL=
UPTIME_SLUG=

# Public device snapshot scope; change when the authorized account/permissions change.
UMAMI_DEVICE_REVISION=
