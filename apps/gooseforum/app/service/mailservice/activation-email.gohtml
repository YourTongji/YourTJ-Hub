<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{call .T "email.activation.subject"}}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
            background-color: #f4f5f7;
            color: #1f2430;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }
        .wrapper { max-width: 600px; margin: 0 auto; padding: 32px 16px; }
        .header { text-align: center; padding: 8px 0 24px; }
        .brand {
            display: inline-block;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.02em;
            color: #2563eb;
            background: #eef2ff;
            border: 1px solid #e0e7ff;
            border-radius: 999px;
            padding: 8px 20px;
        }
        .card {
            background: #ffffff;
            border: 1px solid #e6e8ec;
            border-radius: 16px;
            padding: 36px 36px 32px;
            box-shadow: 0 12px 32px -18px rgb(31 36 48 / 0.18);
        }
        h1 { font-size: 20px; font-weight: 700; color: #111827; margin-bottom: 16px; }
        p { font-size: 14px; color: #4b5563; margin-bottom: 12px; }
        .greeting { color: #374151; font-weight: 500; }
        .action { text-align: center; margin: 28px 0 24px; }
        .button {
            display: inline-block;
            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            background-color: #2563eb;
            border-radius: 10px;
            padding: 13px 32px;
            text-decoration: none;
            box-shadow: 0 8px 20px -10px rgb(37 99 235 / 0.55);
        }
        .fallback { font-size: 13px; color: #6b7280; margin-bottom: 8px; }
        .link {
            display: block;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 12px;
            color: #2563eb;
            background: #f5f7fb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 16px;
            word-break: break-all;
            user-select: all;
        }
        .note { font-size: 12.5px; color: #9ca3af; }
        .footer { text-align: center; padding: 24px 16px 8px; }
        .footer p { font-size: 12px; color: #9ca3af; margin: 0; }
    </style>
</head>
<body>
<div class="wrapper">
    <div class="header">
        <span class="brand">{{.SiteName}}</span>
    </div>
    <div class="card">
        <h1>{{call .T "email.activation.heading" "site" .SiteName}}</h1>
        <p class="greeting">{{call .T "email.greeting" "username" .Username}}</p>
        <p>{{call .T "email.activation.instruction"}}</p>
        <div class="action">
            <a href="{{.ActivationLink}}" class="button">{{call .T "email.activation.button"}}</a>
        </div>
        <p class="fallback">{{call .T "email.copyLink"}}</p>
        <code class="link">{{.ActivationLink}}</code>
        <p class="note">{{call .T "email.activation.expires"}}</p>
    </div>
    <div class="footer">
        <p>{{.SiteName}}</p>
    </div>
</div>
</body>
</html>
