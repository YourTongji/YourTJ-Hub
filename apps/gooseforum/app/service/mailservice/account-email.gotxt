{{define "activation"}}{{.SiteName}}

{{call .T "email.activation.heading" "site" .SiteName}}
{{call .T "email.greeting" "username" .Username}}

{{call .T "email.activation.instruction"}}
{{.ActivationLink}}

{{call .T "email.activation.expires"}}

{{call .T "email.activation.ignore"}}

{{call .T "email.activation.recovery"}}
{{.RecoveryLink}}

{{call .T "email.activation.manualRecovery"}}

{{.SiteName}}{{end}}
{{define "passwordReset"}}{{.SiteName}}

{{call .T "email.passwordReset.heading"}}
{{call .T "email.greeting" "username" .Username}}

{{call .T "email.passwordReset.instruction"}}
{{.ResetLink}}

{{call .T "email.passwordReset.securityTitle"}}
- {{call .T "email.passwordReset.expires"}}
- {{call .T "email.passwordReset.ignore"}}
- {{call .T "email.passwordReset.keepPrivate"}}

{{call .T "email.passwordReset.contact"}}

{{.SiteName}}{{end}}
{{define "emailChanged"}}{{.SiteName}}

{{call .T "email.changed.heading"}}
{{call .T "email.greeting" "username" .Username}}

{{call .T "email.changed.instruction" "site" .SiteName "username" .Username "newEmail" .NewEmail}}

{{call .T "email.changed.securityTitle"}}
{{call .T "email.changed.securityNote"}}

{{call .T "email.changed.contact"}}

{{.SiteName}}{{end}}
{{define "emailChangePending"}}{{.SiteName}}

{{call .T "email.changePending.heading"}}
{{call .T "email.greeting" "username" .Username}}

{{call .T "email.changePending.instruction" "site" .SiteName "username" .Username "newEmail" .NewEmail}}

{{call .T "email.changed.securityTitle"}}
