{{template "layout/app.gohtml" .}}

{{define "noscript"}}
{{template "page" .}}
{{end}}

{{define "page"}}
{{if eq .Payload.Component "wiki.detail"}}<main class="gf-crawler-wiki-page">
    <article class="gf-crawler-wiki-head">
        <h1>{{.Payload.Props.Page.Title}}</h1>
        <p class="gf-crawler-post-meta">
            <span class="gf-crawler-wiki-namespace">{{.Payload.Props.Page.Namespace}}</span>
            <a href="/wiki/{{.Payload.Props.Page.Path}}">/wiki/{{.Payload.Props.Page.Path}}</a>
            <time datetime="{{.Payload.Props.Page.UpdatedAt}}">{{.Payload.Props.Page.UpdatedAt}}</time>
            <span>{{.Payload.Props.Page.ViewCount}} {{ t .Lang "views" }}</span>
            <span>{{.Payload.Props.Page.LikeCount}} {{ t .Lang "likes" }}</span>
            <span>{{.Payload.Props.Page.PostCount}} {{ t .Lang "replies" }}</span>
        </p>
    </article>

    {{if .Payload.Props.Page.Content}}
    <section class="gf-crawler-wiki-body gf-prose">
        {{SafeHTML .Payload.Props.Page.Content}}
    </section>
    {{end}}
</main>{{else}}<main class="gf-crawler-wiki-page">
    <h1>Wiki</h1>
    {{if .Payload.Props.Recent}}
    <section class="gf-crawler-topic-list" aria-label="Recent wiki pages">
        <ul class="gf-crawler-topic-items">
            {{range .Payload.Props.Recent}}
            <li class="gf-crawler-topic-row">
                <div class="gf-crawler-topic-main">
                    <h2 class="gf-crawler-topic-title"><a href="/wiki/{{.Path}}">{{.Title}}</a></h2>
                    <p class="gf-crawler-topic-meta">{{.UpdatedAt}}</p>
                </div>
            </li>
            {{end}}
        </ul>
    </section>
    {{end}}
</main>{{end}}
{{end}}
