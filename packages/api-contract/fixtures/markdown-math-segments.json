{
  "description": "Math delimiters recognised in Markdown (server math protection, Web KaTeX enhancement, app renderer). Each case lists the segments extracted from `source`, in order: `text` is the TeX handed to the renderer (begin/end environments keep their markers), `display` selects block layout. Unlisted text stays literal. Offsets are omitted because Go counts bytes and JavaScript/Dart count UTF-16 units.",
  "cases": [
    {
      "source": "$x$",
      "segments": [
        {
          "text": "x",
          "display": false
        }
      ]
    },
    {
      "source": "$$x$$",
      "segments": [
        {
          "text": "x",
          "display": true
        }
      ]
    },
    {
      "source": "a $x$ and $$y$$ end",
      "segments": [
        {
          "text": "x",
          "display": false
        },
        {
          "text": "y",
          "display": true
        }
      ]
    },
    {
