  "version": "1.0.17",
  "buildNumber": 33,
  "highlights": [
    {
      "id": "pr-1070",
      "title": "匿名身份",
      "summary": "支持设置持久匿名身份，在允许匿名的板块发帖和回复，并管理匿名主页。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1133",
      "title": "主页隐私设置",
      "summary": "分别设置个人主页内容分区的可见范围，访问结果遵循服务端权限。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1058",
      "title": "机器人回复开关",
      "summary": "主题作者可以设置是否允许机器人回复自己的主题。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1168",
      "title": "通行密钥",
      "summary": "在站点开启且设备支持时，可添加、管理通行密钥并用于登录。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1043",
      "title": "内容审核进度",
      "summary": "在内容管理中跟踪审核状态，已公开内容修改送审时保留原公开版本，被拒后可修改重提。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1234",
      "title": "审核结果申诉",
      "summary": "在内容管理中查看被拒版本和原因，并发起申诉。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1121",
      "title": "个人贴纸审核",
      "summary": "上传个人贴纸后查看审核状态，通过后再使用。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1157",
      "title": "个人资料装饰",
      "summary": "支持展示管理员配置的头像框和昵称样式。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1208",
      "title": "平台链接预览",
      "summary": "支持在内容中展示 B 站和 Apple Music 链接预览。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "feature"
    },
    {
      "id": "pr-1214",
      "title": "外链打开提示",
      "summary": "按站点白名单处理外链，受信任的链接可免去重复确认。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1123",
      "title": "搜索页面",
      "summary": "调整搜索入口、最近搜索和结果分类布局，支持删除单条搜索记录。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1135",
      "title": "消息分类",
      "summary": "按互动类型浏览通知，分类入口增加图标，并可结合未读筛选。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1135-push",
      "title": "私信与互动推送",
      "summary": "完善私信和互动通知的推送分类及内容展示。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1170",
      "title": "平板与宽屏布局",
      "summary": "按窗口宽度组织导航和内容，改善设置页及阅读页面的大屏布局。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1237",
      "title": "推荐原因展示",
      "summary": "在推荐帖子卡片和列表条目中直接展示推荐原因。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1169",
      "title": "Emoji 显示与复制",
      "summary": "统一内容中的 Twemoji 展示，改善 Emoji 文本选择与复制。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1117",
      "title": "邮箱激活引导",
      "summary": "补充未激活邮箱的提示及重新发送验证邮件入口。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1137",
      "title": "启动页面衔接",
      "summary": "在品牌启动层下完成数据准备，就绪后再显示应用内容。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "improvement"
    },
    {
      "id": "pr-1287",
      "title": "回复编辑",
      "summary": "使用全屏回复编辑器修改内容，保留图片、贴纸和提及操作。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "fix"
    },
    {
      "id": "pr-1286",
      "title": "键盘与表情切换",
      "summary": "改善回复区在键盘和表情面板切换时的位置保持。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "fix"
    },
    {
      "id": "pr-1130",
      "title": "编辑器光标跟随",
      "summary": "输入时让光标保持在可见区域，并限制正文图片的编辑展示高度。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "fix"
    },
    {
      "id": "pr-1118",
      "title": "排课搜索输入",
      "summary": "修复排课器搜索时键盘收起和输入内容丢失的问题。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "fix"
    },
    {
      "id": "pr-1141",
      "title": "课表显示",
      "summary": "修复课表覆盖灰框和调休规则相关的状态冲突。",
      "platforms": [
        "android",
        "ios"
      ],
      "kind": "fix"
    },
    {
      "id": "pr-1247",
      "title": "账户抽屉返回",
      "summary": "Android 返回操作优先关闭账户抽屉，保留当前页面。",
      "platforms": [
        "android"
      ],
      "kind": "fix"
    }
  ],
