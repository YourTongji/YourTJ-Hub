# Copy to deploy/.env and adjust per environment.
# Note: GooseForum is configured by config.toml (see apps/gooseforum).
# Local development: place config.toml inside apps/gooseforum/ (gitignored).

# Forum backend (GooseForum config.toml [server] section)
YOURTJ_URL=http://localhost
YOURTJ_PORT=5234

# Search (Meilisearch, matches config.toml [meilisearch] section)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=yourtj-dev-master-key

# Web Push 浏览器推送（可选增强通道，matches config.toml [webpush] section）。
# 留空 = 通道关闭（dev 保持空，快照同步的订阅/任务行绝不外发）。
# 生成密钥对：cd apps/gooseforum && go run . webpush-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# PostgreSQL (deployment default main db, matches config.toml [db.default] when connection="postgres").
# main/dev use two separate databases (yourtj_main / yourtj_dev) to keep instances isolated.
# init-server.sh generates a random POSTGRES_PASSWORD on fresh installs and fills
# missing keys on existing servers; set POSTGRES_PASSWORD yourself only when you
# provision PostgreSQL externally (e.g. a managed instance).
POSTGRES_USER=yourtj
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# OCI 镜像仓库(CI 构建推送 GHCR; 服务器匿名 pull 公开镜像, 无需凭证)
IMAGE_REPO=ghcr.io/yourtongji/yourtj-hub
