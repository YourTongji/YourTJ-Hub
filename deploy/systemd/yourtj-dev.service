[Unit]
Description=YourTJ Hub - Development forum (dev, synced from main)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yourtj
Group=yourtj
WorkingDirectory=/srv/yourtj/dev
ExecStart=/srv/yourtj/dev/bin/yourtj-hub serve
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/yourtj/dev/storage

[Install]
WantedBy=multi-user.target
