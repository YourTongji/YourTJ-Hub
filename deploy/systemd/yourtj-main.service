[Unit]
Description=YourTJ Hub - Production forum (main)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yourtj
Group=yourtj
WorkingDirectory=/srv/yourtj/main
ExecStart=/srv/yourtj/main/bin/yourtj-hub serve
Restart=on-failure
RestartSec=5
# 生产启动包含 AutoMigrate, 给足时间
TimeoutStartSec=300
# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/yourtj/main/storage

[Install]
WantedBy=multi-user.target
