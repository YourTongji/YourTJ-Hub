# Cloudflare R2 offsite backup credentials & policy (/opt/yourtj/backup/r2.env).
# Permissions MUST be 0600 (root:root). Never commit populated values.
#
# Use a DEDICATED R2 bucket and API token separate from media/image uploads.
# Save PGBACKREST_CIPHER_PASS and RESTIC_PASSWORD offline in your password manager:
# without them, encrypted backups in R2 cannot be decrypted.

R2_ACCOUNT_ID=REPLACE_R2_ACCOUNT_ID
R2_BUCKET=REPLACE_R2_BUCKET
R2_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY

# Separate prefixes inside the backup bucket so pgBackRest and restic never collide.
R2_PGBACKREST_PATH=/pgbackrest
R2_RESTIC_PREFIX=restic

# Client-side encryption passphrases (generate with: openssl rand -base64 32)
PGBACKREST_CIPHER_PASS=REPLACE_PGBACKREST_CIPHER_PASS
RESTIC_PASSWORD=REPLACE_RESTIC_PASSWORD

# PostgreSQL physical backup + WAL archiving via pgBackRest
PGBACKREST_ENABLED=true
PGBACKREST_STANZA=main
# Day of week for full backup (1=Mon .. 7=Sun); other days take diff backups.
PG_FULL_BACKUP_DOW=7
# pgBackRest retention (2 weekly full backups = >=14 days PITR window)
PGBACKREST_RETENTION_FULL=2
PGBACKREST_RETENTION_DIFF=7

# Also include a verified logical pg_dump (-Fc) inside daily restic snapshots
LOGICAL_PG_BACKUP=true

# restic retention policy (set RESTIC_SKIP_PRUNE=true when using a no-delete R2 token)
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6
RESTIC_SKIP_PRUNE=false

# Health watchdog thresholds (check-backup-health.sh)
MAX_WAL_ARCHIVE_AGE_MIN=45
MAX_BACKUP_AGE_HOURS=36
MAX_DISK_USAGE_PCT=85
MAX_PG_WAL_MB=1024

# Optional alert webhook (generic JSON POST on failure; secret-free message)
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_NOTIFY_ON_SUCCESS=false
