# Waline 服务端环境变量示例（复制为 .env 填写）
# 登录链路：Waline --OAUTH_URL--> OAuth Center(walinejs/auth) --> YourTJ-Hub OIDC

# 站点
SITE_URL=https://wiki.example.com
SITE_NAME=YourTJ Wiki
# 允许评论的域名白名单，防跨站刷评。
# 注意：必须包含 Waline 服务自身域名（/ui 管理后台登录按钮的 Referer
# 校验会检查它，缺了按钮 403）。示例：站点域名 + comment 服务域名
SECURE_DOMAINS=wiki.example.com,comment.example.com

# OAuth Center 地址（walinejs/auth，自托管或 Vercel）
OAUTH_URL=https://auth.example.com

# 必填：登录 token 密钥（openssl rand -hex 32）
JWT_TOKEN=replace-with-a-random-token

# --- MySQL（生产推荐；需先导入 https://github.com/walinejs/waline/blob/main/assets/waline.sql）---
# MYSQL_DB=waline
# MYSQL_USER=waline
# MYSQL_PASSWORD=changeme
# MYSQL_HOST=db.example.com
# MYSQL_PORT=3306
# MYSQL_PREFIX=wl_

# --- 邮件通知（可选）---
# SMTP_SERVICE=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# AUTHOR_EMAIL=

# --- 反垃圾（可选）---
# AKISMET_KEY=
